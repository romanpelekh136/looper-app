{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guitar YouTube Looper",
  "version": "0.1.0",
  "identifier": "com.guitarlooper.app",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Guitar YouTube Looper",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
